# Expense Reports application environment configuration
# Update these values to control the default admin user and organization bootstrap data.

# Administrative user created automatically when the database is initialised.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Default organization details used when seeding a new installation.
DEFAULT_ORG_NAME=Main Organization
DEFAULT_ORG_LEGAL_NAME=Main Organization BV
DEFAULT_ORG_ADDRESS_LINE1=Straatnaam 1
DEFAULT_ORG_ADDRESS_LINE2=
DEFAULT_ORG_POSTAL=1000
DEFAULT_ORG_CITY=Brussel
DEFAULT_ORG_COUNTRY=België
DEFAULT_ORG_VAT=BE0000000000
DEFAULT_ORG_IBAN=BE00 0000 0000 0000
DEFAULT_ORG_BANK=FinBank
DEFAULT_ORG_COLOR_PRIMARY=#1f2933
DEFAULT_ORG_COLOR_ACCENT=#3b82f6
DEFAULT_ORG_NUMBER_PREFIX=EXP
DEFAULT_ORG_NEXT_NUMBER=1

# Keep local development on localhost. Production requires a private absolute data path and HTTPS.
APP_ENV=development
APP_HTTPS=0
APP_TIMEZONE=Europe/Brussels
# EXPENSE_DB_PATH=/home/ACCOUNT/flowexpense-private/data/expenses.db
# BACKUP_DIR=/home/ACCOUNT/flowexpense-private/backups
BACKUP_AUTOMATIC=1

# Public guest demo only: use a separate deployment and dedicated private storage.
# FLOWEXPENSE_DEMO=1
# DEMO_STORAGE_ROOT=/absolute/path/outside/public_html/flowexpense-guest-data

# Combined real-account login and isolated Guest entry at the same URL (optional):
# GUEST_ENABLED=1
# Keep FLOWEXPENSE_DEMO=0 for this combined mode.
